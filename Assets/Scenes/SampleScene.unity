    - target: {fileID: 3847986674006558913, guid: 3cb3be45f33e99d449c1b490041565c2,
        type: 3}
      propertyPath: letterText
      value: 
      objectReference: {fileID: 1254243689}
    - target: {fileID: 3847986674006558913, guid: 3cb3be45f33e99d449c1b490041565c2,
        type: 3}
      propertyPath: introCanvasGroup
      value: 
      objectReference: {fileID: 2102883877}
    - target: {fileID: 3847986674006558913, guid: 3cb3be45f33e99d449c1b490041565c2,
        type: 3}
      propertyPath: introLines.Array.size
      value: 11
      objectReference: {fileID: 0}
    - target: {fileID: 3847986674006558913, guid: 3cb3be45f33e99d449c1b490041565c2,
        type: 3}
      propertyPath: introLines.Array.data[2]
      value: 'E poi, quando sei ad un passo dall''ottenerlo, ti viene portato via
        da... '
      objectReference: {fileID: 0}
    - target: {fileID: 3847986674006558913, guid: 3cb3be45f33e99d449c1b490041565c2,
        type: 3}
      propertyPath: introLines.Array.data[3]
      value: una banana???
      objectReference: {fileID: 0}
    - target: {fileID: 3847986674006558913, guid: 3cb3be45f33e99d449c1b490041565c2,
        type: 3}
      propertyPath: introLines.Array.data[4]
      value: ED IO CHE NE SO?
      objectReference: {fileID: 0}
    - target: {fileID: 3847986674006558913, guid: 3cb3be45f33e99d449c1b490041565c2,
        type: 3}
      propertyPath: introLines.Array.data[5]
      value: CHIEDILO A RYO!
      objectReference: {fileID: 0}
    - target: {fileID: 3847986674006558913, guid: 3cb3be45f33e99d449c1b490041565c2,
        type: 3}
      propertyPath: introLines.Array.data[6]
      value: "Ryo, c\u2019\xE8 un nome che ti viene affibiato come fosse un programma:
        elegante, preciso, pronto a seguire istruzioni."
      objectReference: {fileID: 0}
    - target: {fileID: 3847986674006558913, guid: 3cb3be45f33e99d449c1b490041565c2,
        type: 3}
      propertyPath: introLines.Array.data[7]
      value: "Hai fatto tutto \u201Cgiusto\u201D: orari perfetti, sorriso calibrato,
        sacrifici silenziosi. Eppure, dentro, qualcosa non resta al suo posto."
      objectReference: {fileID: 0}
    - target: {fileID: 3847986674006558913, guid: 3cb3be45f33e99d449c1b490041565c2,
        type: 3}
      propertyPath: introLines.Array.data[8]
      value: 'Qualcosa che scalcia, che vuole uscire dal copione. '
      objectReference: {fileID: 0}
    - target: {fileID: 3847986674006558913, guid: 3cb3be45f33e99d449c1b490041565c2,
        type: 3}
      propertyPath: introLines.Array.data[9]
      value: Non ti sto dicendo di tradire chi ti ha cresciuto...
      objectReference: {fileID: 0}
    - target: {fileID: 3847986674006558913, guid: 3cb3be45f33e99d449c1b490041565c2,
        type: 3}
      propertyPath: introLines.Array.data[10]
      value: "...sto solo suggerendo che esiste un\u2019altra strada, e che forse
        \xE8 il momento di cercarla..."
      objectReference: {fileID: 0}
    - target: {fileID: 5435390221412303423, guid: 3cb3be45f33e99d449c1b490041565c2,
